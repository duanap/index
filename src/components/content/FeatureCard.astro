---
import type { FeatureEntry } from "../../lib/feature-content";
import { featureHref } from "../../lib/feature-content";
import { t, formatDate } from "../../i18n";
interface Props {
  entry: FeatureEntry;
}
const { entry } = Astro.props;
---

<article class="card feature-card">
  <a class="feature-cover" href={featureHref(entry)}>
    {entry.image ? (
      <img
        src={entry.image}
        alt={entry.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span
        class:list={[
          "feature-placeholder",
          entry.collection === "life"
            ? "icon-[lucide--flower-2]"
            : "icon-[lucide--folder-heart]",
        ]}
        aria-hidden="true"
      ></span>
    )}
  </a>
  <div class="feature-body">
    {entry.featured && <span class="chip">{t("features.featured")}</span>}
    <h3>
      <a href={featureHref(entry)}>{entry.title}</a>
    </h3>
    <p>{entry.excerpt}</p>
    {entry.date && (
      <time datetime={entry.date.toISOString()}>
        {formatDate(entry.date.toISOString())}
      </time>
    )}
  </div>
</article>
<style>
  .feature-card {
    overflow: hidden;
    min-width: 0;
  }
  .feature-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16/10;
    background: var(--accent-soft);
  }
  .feature-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature-placeholder {
    font-size: 48px;
    color: var(--accent);
  }
  .feature-body {
    padding: 18px;
  }
  h3 {
    font-size: 17px;
    margin: 7px 0;
    overflow-wrap: anywhere;
  }
  p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.8;
  }
  time {
    color: var(--muted);
    font-size: 11px;
  }
</style>
