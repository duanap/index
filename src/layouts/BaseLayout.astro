---
import { t } from "../i18n";
import { siteInfo, personalInfo, welcomeConfig } from "../config";
import "../styles/global.css";
import "@fontsource-variable/noto-sans";
import "@fontsource-variable/noto-sans-jp";
import "@fontsource-variable/noto-sans-sc";
import "@fontsource-variable/jetbrains-mono";
import Navigation from "../components/header/Navigation.vue";
import Welcome from "../components/header/Welcome.astro";
import HeroCarousel from "../components/header/HeroCarousel.vue";
import FooterLinks from "../components/FooterLinks.astro";
import { getKanadeSiteSettings, heroSlides } from "../lib/site-settings";
import Search from "../components/header/Search.vue";
import MainContainer from "../components/MainContainer.vue";
import { getPosts, summarize } from "../lib/posts";
import { getSeoMeta } from "emdash/seo";
import type { ContentSeo } from "emdash";
interface Props {
  seo?: ContentSeo;
  title?: string;
  description?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  home?: boolean;
  article?: boolean;
  publishedTime?: string;
  noindex?: boolean;
}
const {
  title,
  description = siteInfo.description,
  heroTitle,
  heroSubtitle,
  home = false,
  article = false,
  publishedTime,
  noindex = false,
  seo,
} = Astro.props;
const posts = (await getPosts(Astro.locals)).map(summarize);
const cmsSettings = await getKanadeSiteSettings(Astro.locals);
const slides = home ? heroSlides(cmsSettings) : [];
const defaultPageTitle = title
  ? `${title} · ${siteInfo.title}`
  : `${siteInfo.title} · ${siteInfo.titleSuffix}`;
const meta = seo
  ? getSeoMeta(
      { data: { title, excerpt: description, seo } },
      {
        siteTitle: siteInfo.title,
        siteUrl: siteInfo.url,
        path: Astro.url.pathname,
        titleSeparator: " · ",
        defaultOgImage: new URL(welcomeConfig.bgImage, siteInfo.url).href,
      },
    )
  : undefined;
const pageTitle = meta?.title || defaultPageTitle;
const metaDescription = meta?.description || description;
const canonical =
  meta?.canonical || new URL(Astro.url.pathname, siteInfo.url).href;
const image =
  meta?.ogImage || new URL(welcomeConfig.bgImage, siteInfo.url).href;
const robots = noindex ? "noindex, follow" : meta?.robots;
---

<!doctype html>
<html lang={siteInfo.language}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={siteInfo.favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={siteInfo.keywords.join(", ")} />
    <meta name="author" content={personalInfo.name} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#fff5e7" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name" content={siteInfo.title} />
    <meta property="og:locale" content={siteInfo.locale} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    {article && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteInfo.title} RSS`}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        document.documentElement.classList.toggle(
          "dark",
          theme === "dark" ||
            (theme !== "light" &&
              matchMedia("(prefers-color-scheme: dark)").matches),
        );
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t("common.skip")}
    </a>
    <Navigation pathname={Astro.url.pathname} client:load />
    <Search posts={posts} client:load />
    {slides.length ? (
      <HeroCarousel
        slides={slides}
        options={cmsSettings.heroCarousel}
        fallback={welcomeConfig.bgImage}
        client:load
      />
    ) : (
      <Welcome
        compact={!home}
        title={heroTitle}
        subtitle={heroSubtitle}
        headingLevel={article ? 2 : 1}
      />
    )}
    <MainContainer>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </MainContainer>
    <footer class="site-footer">
      <a href="/" class="footer-mark">
        <span class="accent">✿</span> {siteInfo.title}.
      </a>
      <p>{t("footer.message")}</p>
      <p>
        © {new Date().getFullYear()} {personalInfo.englishName} ·{" "}
        {t("footer.builtWith")}{" "}
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">
          Astro
        </a>{" "}
        &amp; <span class="accent">♥</span> ·{" "}
        <a href="/rss.xml">{t("common.rss")}</a> ·{" "}
        <a href="/about/">{t("common.aboutSite")}</a>
      </p>
      <FooterLinks />
    </footer>
    <button
      class="back-top"
      id="back-top"
      aria-label={t("common.backTop")}
      hidden
    >
      <span class="icon-[lucide--arrow-up]"></span>
    </button>
    <script>
      const button = document.querySelector<HTMLButtonElement>("#back-top");
      const update = () => {
        if (button) button.hidden = window.scrollY < 500;
      };
      window.addEventListener("scroll", update, { passive: true });
      button?.addEventListener("click", () =>
        window.scrollTo({
          top: 0,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
        }),
      );
      update();
    </script>
  </body>
</html>
