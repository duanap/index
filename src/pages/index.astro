---
import { t } from "../i18n";
import BlogLayout from "../layouts/BlogLayout.astro";
import PostFeed from "../components/posts/PostFeed.vue";
import PostListFallback from "../components/posts/PostListFallback.astro";
import { getPosts, summarize } from "../lib/posts";
import { getFeatureEntries } from "../lib/features";
import FeatureList from "../components/content/FeatureList.astro";
const posts = (await getPosts(Astro.locals)).map(summarize);
const life = (await getFeatureEntries("life", Astro.locals)).slice(0, 4);
const projects = (await getFeatureEntries("projects", Astro.locals))
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 4);
---

<BlogLayout home>
  <div class="hello-strip">
    <span class="icon-[lucide--sparkles]" aria-hidden="true"></span>
    <p>{t("home.greeting")}</p>
    <span class="hello-pill">{t("home.greetingBadge")}</span>
  </div>
  <PostFeed posts={posts} client:load />
  <PostListFallback posts={posts} />
  <section class="home-features">
    <h2>
      <a href="/life/">{t("nav.life")} →</a>
    </h2>
    <FeatureList entries={life} />
  </section>
  <section class="home-features">
    <h2>
      <a href="/projects/">{t("nav.projects")} →</a>
    </h2>
    <FeatureList entries={projects} />
  </section>
</BlogLayout>
<style>
  .home-features {
    margin-top: 28px;
  }
  .home-features h2 {
    font-size: 20px;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .hello-strip {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--accent);
    font-size: 11px;
    margin: 0 0 21px;
    padding: 11px 15px;
    border: 1px dashed #dfbc8180;
    border-radius: 11px;
    background: #ffffff25;
  }
  .hello-strip > span:first-child {
    font-size: 17px;
    flex-shrink: 0;
  }
  .hello-strip p {
    margin: 0;
    flex: 1;
  }
  .hello-pill {
    font:
      7px "Oxanium-Medium",
      var(--font-body);
    letter-spacing: 0.05em;
    opacity: 0.65;
  }
  @media (max-width: 760px) {
    .hello-strip {
      font-size: 10px;
      margin-bottom: 22px;
    }
    .hello-pill {
      display: none;
    }
  }
</style>
