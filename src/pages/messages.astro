---
import { t } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import Guestbook from "../components/Guestbook.vue";
import { resolveMessageBoard, getBoardMessages } from "../lib/message-board";
const board = await resolveMessageBoard(Astro.locals);
const messages = board ? await getBoardMessages(board.id) : [];
---

<BaseLayout
  title={t("guestbook.pageTitle")}
  description={t("guestbook.description")}
  heroTitle={t("guestbook.heroTitle")}
  heroSubtitle={t("guestbook.heroSubtitle")}
>
  <div class="shell guestbook-shell">
    <Guestbook boardId={board?.id} initialMessages={messages} client:load />
  </div>
</BaseLayout>
<style>
  .guestbook-shell {
    padding-top: 24px;
    padding-bottom: 42px;
  }
  @media (max-width: 760px) {
    .guestbook-shell {
      padding-top: 18px;
      padding-bottom: 28px;
    }
  }
</style>
