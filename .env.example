# Local: http://localhost:4321. Production: https://duanap.cn (build AND runtime).
SITE_URL=https://duanap.cn
EMDASH_SITE_URL=https://duanap.cn
# Absolute persistent directory in production; default ./data in development.
# KANADE_DATA_DIR=/www/kanade-data/duanap.cn
# Generate EMDASH_ENCRYPTION_KEY with pnpm run setup; never commit or rotate it casually.
# Do not define an empty encryption key here.
# Optional build override; otherwise src/site.config.json selects the language.
# PUBLIC_SITE_LANGUAGE=en
# Static JPEG/PNG conversion limits; original files are retained.
# KANADE_WEBP_QUALITY=82
# KANADE_IMAGE_MAX_EDGE=2560
